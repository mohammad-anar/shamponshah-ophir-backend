  boards  FamilyBoard[]

  @@map("family_workspaces")
}

model FamilyMember {
  id                String          @id @default(cuid())
  familyWorkspaceId String
  familyWorkspace   FamilyWorkspace @relation(fields: [familyWorkspaceId], references: [id])
  userId            String
  user              User            @relation(fields: [userId], references: [id])

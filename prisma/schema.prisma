  @@map("family_boards")
}

model FamilyBoardItem {
  id        String      @id @default(cuid())
  boardId   String
  board     FamilyBoard @relation(fields: [boardId], references: [id])
  vendorId  String?
  gigId     String?
  title     String
  notes     String?
  status    String      @default("SHORTLISTED")
  votes     Json?
  createdAt DateTime    @default(now())

  @@map("family_board_items")
}


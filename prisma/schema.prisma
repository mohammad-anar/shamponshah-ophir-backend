model BidCreditPackage {
  id        String   @id @default(cuid())
  name      String
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  isPopular Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("bid_credit_packages")
}

model BidCreditTransaction {
  id              String   @id @default(cuid())
  vendorProfileId String
  credits         Int
  type            String
  offerId         String?
  stripeId        String?
  description     String?
  createdAt       DateTime @default(now())

  @@map("bid_credit_transactions")
}


  @@map("stripe_webhook_events")
}

// ─────────────────────────────────────────────────────────────
// VENDOR WALLET & LEDGER
// ─────────────────────────────────────────────────────────────

enum LedgerStatus {
  PENDING
  CLEARING
  AVAILABLE
  WITHDRAWN
  CANCELLED
  REFUNDED
}

enum LedgerEntryType {
  ORDER_PAYMENT
  DELIVERY_ACCEPTED
  FUNDS_CLEARED
  WITHDRAWAL
  REFUND_DEDUCTION
}

model VendorWallet {
  id                      String        @id @default(cuid())
  vendorProfileId         String        @unique
  vendorProfile           VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  pendingAmount           Decimal       @default(0) @db.Decimal(10, 2)
  pendingForReleaseAmount Decimal       @default(0) @db.Decimal(10, 2)
  availableAmount         Decimal       @default(0) @db.Decimal(10, 2)
  totalEarned             Decimal       @default(0) @db.Decimal(10, 2)
  totalWithdrawn          Decimal       @default(0) @db.Decimal(10, 2)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  ledgerEntries           WalletLedgerEntry[]

  @@map("vendor_wallets")
}

model WalletLedgerEntry {
  id              String          @id @default(cuid())
  walletId        String
  wallet          VendorWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  vendorProfileId String
  vendorProfile   VendorProfile   @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type            LedgerEntryType @default(ORDER_PAYMENT)
  gross           Decimal         @db.Decimal(10, 2)
  platformFee     Decimal         @db.Decimal(10, 2)
  vendorNet       Decimal         @db.Decimal(10, 2)
  status          LedgerStatus    @default(PENDING)
  clearingEndsAt  DateTime?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("wallet_ledger_entries")
}

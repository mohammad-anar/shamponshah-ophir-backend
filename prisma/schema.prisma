model Review {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation("OrderReviews", fields: [orderId], references: [id])
  gigId           String?
  gig             Gig?          @relation("GigReviews", fields: [gigId], references: [id])
  clientProfileId String
  clientProfile   ClientProfile @relation("ClientReviews", fields: [clientProfileId], references: [id])
  vendorProfileId String
  vendorProfile   VendorProfile @relation("VendorReviews", fields: [vendorProfileId], references: [id])
  rating          Int
  title           String?
  comment         String        @db.Text
  isPublished     Boolean       @default(true)
  vendorReply     String?       @db.Text
  repliedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("reviews")
}

